# Google Cloud Configuration
# ==========================
# Copy this file to .env and fill in your values

# Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Dialogflow CX Agent Configuration
DIALOGFLOW_LOCATION=global
DIALOGFLOW_AGENT_ID=your-agent-id

# Path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Server Configuration
PORT=8001

# Agmarknet/Mandi Prices API Configuration
# =========================================
# Get your API key from https://data.gov.in/ogpl_apis
# The default key is a public demo key with rate limits
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# Indian Weather API Configuration
# ================================
# Get your API key from https://weather.indianapi.in
INDIAN_WEATHER_API_KEY=your-indian-weather-api-key

# Optional: Override default voice settings
# TTS_VOICE=mr-IN-Neural2-A
# TTS_SPEAKING_RATE=1.0
# TTS_PITCH=0.0

# Optional: Override default language
# DEFAULT_LANGUAGE=mr-IN
