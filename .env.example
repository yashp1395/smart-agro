#===============================================================================
# Smart Agro - Environment Variables
#===============================================================================
# Copy this file to relevant service directories and fill in your values
#
# Frontend: smart-agro/.env
# Voice Bot: smart-agro/voice-bot-backend/.env
#===============================================================================

#-------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (smart-agro/.env)
#-------------------------------------------------------------------------------
# Google Gemini API Key for AI features
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key for weather data
VITE_WEATHER_API_KEY=your_openweather_api_key_here

# Backend API URLs (default values for local development)
VITE_CROP_PREDICTION_API=http://localhost:5000
VITE_DISEASE_DETECTION_API=http://localhost:8000
VITE_VOICE_BOT_API=http://localhost:8001

#-------------------------------------------------------------------------------
# VOICE BOT BACKEND CONFIGURATION (smart-agro/voice-bot-backend/.env)
#-------------------------------------------------------------------------------
# Google Cloud credentials file path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Dialogflow CX Configuration
DIALOGFLOW_AGENT_ID=your-agent-id
DIALOGFLOW_LOCATION=global

# Server port
PORT=8001

#-------------------------------------------------------------------------------
# Service Ports (for reference)
#-------------------------------------------------------------------------------
# Frontend:              5173
# Crop Prediction API:   5000
# Disease Detection API: 8000
# Voice Bot Backend:     8001
